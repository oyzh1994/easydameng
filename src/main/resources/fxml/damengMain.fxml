<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easydameng.tabs.DamengTabPane?>
<?import cn.oyzh.easydameng.tabs.home.DBHomeTab?>
<?import cn.oyzh.fx.plus.controls.pane.FXSplitPane?>
<FXSplitPane xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="cn.oyzh.easydameng.controller.DamengMainController"
             flexWidth="100%" flexHeight="100% - 30" dividerPositions="0.25" fx:id="root">
    <fx:include fx:id="connect" source="main/connect.fxml"/>
    <DamengTabPane fx:id="tabPane" flexHeight="100%"
                   tabClosingPolicy="ALL_TABS" tabDragPolicy="REORDER">
        <DBHomeTab/>
    </DamengTabPane>
</FXSplitPane>
