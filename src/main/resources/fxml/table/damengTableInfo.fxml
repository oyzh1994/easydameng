<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.editor.incubator.Editor?>
<?import cn.oyzh.fx.gui.button.CloseButton?>
<?import cn.oyzh.fx.gui.label.InfoLabel?>
<?import cn.oyzh.fx.gui.text.area.ReadOnlyTextArea?>
<?import cn.oyzh.fx.gui.text.field.ReadOnlyTextField?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FXVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easydameng.controller.table.DamengTableInfoController" realWidth="900" realHeight="600">
    <FXTabPane flexWidth="100%" flexHeight="100% - 50">
        <FixedTab text="%base.base">
            <FXVBox flexWidth="100%" flexHeight="100%">
                <InfoLabel text="%base.tableName">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField tipText="%base.tableName" fx:id="tableName"
                                   realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.engine">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField tipText="%base.engine" fx:id="tableEngine"
                                   realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.charset">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField tipText="%base.charset" fx:id="tableCharset"
                                   realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <InfoLabel text="%base.collation">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextField tipText="%base.collation" fx:id="tableCollation"
                                   realHeight="30" flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextField>
                <FXVBox managed="false" visible="false" fx:id="tableRowFormatBox">
                    <InfoLabel text="%base.rowFormat">
                        <VBox.margin>
                            <Insets left="30" top="10"/>
                        </VBox.margin>
                    </InfoLabel>
                    <ReadOnlyTextField tipText="%base.rowFormat" fx:id="tableRowFormat" realHeight="30"
                                       flexWidth="100% - 180">
                        <VBox.margin>
                            <Insets left="30" top="5"/>
                        </VBox.margin>
                    </ReadOnlyTextField>
                </FXVBox>
                <FXVBox managed="false" visible="false" fx:id="tableAutoIncrementBox">
                    <InfoLabel text="%base.autoIncrement">
                        <VBox.margin>
                            <Insets left="30" top="10"/>
                        </VBox.margin>
                    </InfoLabel>
                    <ReadOnlyTextField tipText="%base.autoIncrement" fx:id="tableAutoIncrement" realHeight="30"
                                       flexWidth="100% - 180">
                        <VBox.margin>
                            <Insets left="30" top="5"/>
                        </VBox.margin>
                    </ReadOnlyTextField>
                </FXVBox>
                <InfoLabel text="%base.comment">
                    <VBox.margin>
                        <Insets left="30" top="10"/>
                    </VBox.margin>
                </InfoLabel>
                <ReadOnlyTextArea fx:id="tableComment" tipText="%base.comment" realHeight="130"
                                  flexWidth="100% - 180">
                    <VBox.margin>
                        <Insets left="30" top="5"/>
                    </VBox.margin>
                </ReadOnlyTextArea>
            </FXVBox>
        </FixedTab>
        <FixedTab text="%base.ddl">
            <FXVBox flexHeight="100%" flexWidth="100%">
                <Editor editable="false" fx:id="tableDefinition" flexHeight="100%" flexWidth="100% - 35">
                    <VBox.margin>
                        <Insets left="30"/>
                    </VBox.margin>
                </Editor>
            </FXVBox>
        </FixedTab>
    </FXTabPane>
    <FXHBox flexWidth="100%">
        <CloseButton>
            <HBox.margin>
                <Insets left="30" top="15"/>
            </HBox.margin>
        </CloseButton>
    </FXHBox>
</FXVBox>
