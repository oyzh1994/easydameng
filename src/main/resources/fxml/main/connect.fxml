<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easydameng.trees.DBTreeView?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ConnectionSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ExportSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ImportSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PositioningSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.pane.SortSVGPane?>
<?import cn.oyzh.fx.plus.controls.box.FXHBox?>
<?import cn.oyzh.fx.plus.controls.box.FXVBox?>
<?import cn.oyzh.fx.plus.controls.tab.FixedTab?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FixedTab xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="cn.oyzh.easydameng.controller.main.ConnectController" text="%base.connection">
    <graphic>
        <ConnectionSVGGlyph cursorType="DEFAULT"/>
    </graphic>
    <FXVBox flexHeight="100%" flexWidth="100%">
        <FXHBox realHeight="30" flexWidth="100%">
            <AddSVGGlyph onMousePrimaryClicked="#addConnect">
                <HBox.margin>
                    <Insets left="5" top="10"/>
                </HBox.margin>
            </AddSVGGlyph>
            <!-- <TerminalSVGGlyph size="15" onMousePrimaryClicked="#openTerminal"> -->
            <!--     <HBox.margin> -->
            <!--         <Insets left="5" top="10"/> -->
            <!--     </HBox.margin> -->
            <!-- </TerminalSVGGlyph> -->
            <ImportSVGGlyph onMousePrimaryClicked="#importConnect" tipText="%base.importConnect">
                <HBox.margin>
                    <Insets left="5" top="10"/>
                </HBox.margin>
            </ImportSVGGlyph>
            <ExportSVGGlyph onMousePrimaryClicked="#exportConnect" tipText="%base.exportConnect">
                <HBox.margin>
                    <Insets left="5" top="10"/>
                </HBox.margin>
            </ExportSVGGlyph>
        </FXHBox>
        <DBTreeView fx:id="tree" flexHeight="100% - 60" flexWidth="100%"/>
        <FXHBox realHeight="30" flexWidth="100%">
            <SortSVGPane fx:id="sortPane" onMousePrimaryClicked="#sortTree">
                <HBox.margin>
                    <Insets left="5" top="5"/>
                </HBox.margin>
            </SortSVGPane>
            <PositioningSVGGlyph onMousePrimaryClicked="#positionNode">
                <HBox.margin>
                    <Insets left="5" top="5"/>
                </HBox.margin>
            </PositioningSVGGlyph>
        </FXHBox>
    </FXVBox>
</FixedTab>

